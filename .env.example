DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/rahomes?retryWrites=true&w=majority"
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="inquiries@rahomesproperties.com"
AGENCY_INBOX_EMAIL="rahomesproperties@gmail.com"
NEXT_PUBLIC_SITE_NAME="RA Homes & Properties"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Keep this as the canonical origin, without a trailing slash. It must match
# the domain registered with each OAuth provider.
NEXTAUTH_URL="https://your-domain.com"

# Cloudinary — used for listing photos and MP4/WebM video walkthroughs.
# This unsigned preset must allow image and video uploads. Both values are
# safe to expose in the browser (this is not the API secret) — see README.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="ra-homes-unsigned"
# Optional but recommended: a separate unsigned preset for MP4/WebM uploads.
# Configure it in Cloudinary to allow only mp4,webm and a 100 MB maximum.
NEXT_PUBLIC_CLOUDINARY_VIDEO_UPLOAD_PRESET="ra-homes-video-unsigned"

# Google / Facebook OAuth — optional, available on the single /login page
# for everyone (regular users, and agents/admins signing in with the same
# account). Leave unset and those buttons just show as disabled — nothing
# else breaks. See README for where to get these from each provider's
# developer console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
