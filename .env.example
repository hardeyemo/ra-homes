DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/rahomes?retryWrites=true&w=majority"
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="inquiries@rahomesproperties.com"
AGENCY_INBOX_EMAIL="admin@rahomesproperties.com"
NEXT_PUBLIC_SITE_NAME="RA Homes & Properties"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Keep this as the canonical origin, without a trailing slash. It must match
# the domain registered with each OAuth provider.
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary — used for agent/admin listing photos and public "List Your
# Property" uploads. Both values are safe to expose in the browser (this is
# an unsigned upload preset, not the API secret) — see README for setup.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="ra-homes-unsigned"

# Google / Facebook OAuth — optional, available on the single /login page
# for everyone (regular users, and agents/admins signing in with the same
# account). Leave unset and those buttons just show as disabled — nothing
# else breaks. See README for where to get these from each provider's
# developer console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
